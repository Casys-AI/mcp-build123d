{
  "name": "@casys/mcp-build123d",
  "version": "0.6.2",
  "tasks": {
    "serve": "deno run --allow-all server.ts --port=3014",
    "serve:stdio": "deno run --allow-all server.ts --stdio",
    "compile": "deno compile -A --output mcp-build123d server.ts",
    "test": "deno test --allow-all tests/",
    "build:ui": "deno run --allow-env --allow-net --allow-read --allow-run --allow-write scripts/build-results-viewer.ts",
    "capture:docs": "deno run --allow-env --allow-net=127.0.0.1 --allow-read --allow-run --allow-write scripts/capture-viewer-doc.ts",
    "generate:harness-source": "deno run --allow-read --allow-write scripts/generate-harness-source.ts && deno fmt src/api/harness-source.ts",
    "generate:assembly-integrity-harness-source": "deno run --allow-read --allow-write scripts/generate-assembly-integrity-harness-source.ts && deno fmt src/api/assembly-integrity-harness-source.ts"
  },
  "fmt": {
    "exclude": [
      "src/ui/dist/"
    ]
  },
  "exports": {
    ".": "./mod.ts",
    "./server": "./server.ts",
    "./view-app-manifest": "./src/ui/view-app-manifest.json"
  },
  "publish": {
    "include": [
      "mod.ts",
      "server.ts",
      "scripts/build-results-viewer.ts",
      "src/**/*.ts",
      "src/**/*.tsx",
      "src/**/*.css",
      "src/**/*.html",
      "src/ui/view-app-manifest.json",
      "src/ui/dist/**/*.html",
      "src/api/harness.py",
      "src/api/assembly-integrity-harness.py",
      "requirements/**/*.txt",
      "docs/**/*.md",
      "docs/assets/**/*.png",
      "README.md",
      "CHANGELOG.md",
      "CITATION.cff",
      "SECURITY.md",
      "LICENSE"
    ],
    "exclude": [
      "**/*_test.ts",
      "**/*.test.ts",
      "**/*.bench.ts"
    ]
  },
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@casys/mcp-view-contracts",
      "jsr:@casys/mcp-view-components",
      "jsr:@casys/mcp-view"
    ]
  },
  "imports": {
    "@casys/mcp-server": "jsr:@casys/mcp-server@0.26.1",
    "@casys/mcp-view-contracts": "jsr:@casys/mcp-view-contracts@0.1.0",
    "@casys/mcp-view-components": "jsr:@casys/mcp-view-components@0.9.0",
    "ajv": "npm:ajv@^8.17.1",
    "hono": "npm:hono@^4",
    "hono/cors": "npm:hono@^4/cors",
    "jose": "npm:jose@^6.0.0",
    "@opentelemetry/api": "npm:@opentelemetry/api@^1.9.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/yaml": "jsr:@std/yaml@^1",
    "@std/assert": "jsr:@std/assert@^1"
  }
}
