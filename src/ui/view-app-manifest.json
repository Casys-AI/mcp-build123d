{
  "schemaVersion": "io.casys.mcp.view-app-manifest/1.0",
  "app": {
    "id": "io.casys.mcp-build123d.results",
    "title": "Build123d inspection",
    "version": "0.7.0"
  },
  "resources": [
    {
      "uri": "ui://mcp-build123d/results-viewer",
      "ownership": "whole-view",
      "resultSchemas": [
        "io.casys.mcp-build123d.geometry-execution-result/1.0",
        "io.casys.mcp-build123d.geometry-export-result/1.0"
      ],
      "acceptedActions": [
        "viewer.session.apply"
      ],
      "sessionSchemas": [
        "io.casys.mcp-build123d.recorded-geometry-session/1.0",
        "io.casys.mcp-build123d.geometry-review-session/1.0"
      ]
    },
    {
      "uri": "ui://mcp-build123d/assembly-viewer",
      "ownership": "whole-view",
      "resultSchemas": [
        "build123d-assembly-integrity-observation/1.0"
      ]
    },
    {
      "uri": "ui://mcp-build123d/drawing-viewer",
      "ownership": "whole-view",
      "resultSchemas": [
        "io.casys.mcp-build123d.drawing-projection/1.0"
      ]
    }
  ]
}
